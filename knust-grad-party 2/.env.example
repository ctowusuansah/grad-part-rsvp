# --- Supabase (Settings > API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin login ---
# Plain password you will type in to log in to /admin. Keep it private.
ADMIN_PASSWORD=change-this-password
# Random long string used to sign the admin login session cookie.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=replace-with-a-random-long-string

# --- Email (Resend: resend.com, free tier) ---
RESEND_API_KEY=your-resend-api-key
# The "from" address must be on a domain you've verified in Resend,
# e.g. "Class of 2026 Grad Party <rsvp@yourdomain.com>".
# Until you verify a domain, Resend lets you send from onboarding@resend.dev.
EMAIL_FROM="Class of 2026 Grad Party <onboarding@resend.dev>"

# --- Deployed site URL (fill in after your first Vercel deploy) ---
NEXT_PUBLIC_SITE_URL=https://your-app-name.vercel.app
